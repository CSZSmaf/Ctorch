@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(Ctorch_USE_BLAS @CTORCH_USE_BLAS@)
set(Ctorch_USE_CUDA @CTORCH_USE_CUDA@)
set(Ctorch_USE_CUDNN @CTORCH_USE_CUDNN@)
set(Ctorch_USE_NPU @CTORCH_USE_NPU@)
set(Ctorch_USE_DLPACK @CTORCH_USE_DLPACK@)
set(Ctorch_SHARED @BUILD_SHARED_LIBS@)

if(Ctorch_USE_BLAS)
    if(DEFINED BLA_SIZEOF_INTEGER)
        set(_Ctorch_saved_bla_size "${BLA_SIZEOF_INTEGER}")
    endif()
    set(BLA_SIZEOF_INTEGER 4)
    find_dependency(BLAS)
    if(DEFINED _Ctorch_saved_bla_size)
        set(BLA_SIZEOF_INTEGER "${_Ctorch_saved_bla_size}")
        unset(_Ctorch_saved_bla_size)
    else()
        unset(BLA_SIZEOF_INTEGER)
    endif()
endif()
if(Ctorch_USE_CUDA)
    find_dependency(Threads)
    find_dependency(CUDAToolkit 12)
endif()
if(Ctorch_USE_CUDNN)
    set(_Ctorch_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(CUDNN 9.7)
    set(CMAKE_MODULE_PATH "${_Ctorch_module_path}")
    unset(_Ctorch_module_path)
endif()

if(Ctorch_USE_DLPACK)
    set(_Ctorch_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(DLPack 1.0...<2)
    set(CMAKE_MODULE_PATH "${_Ctorch_module_path}")
    unset(_Ctorch_module_path)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CtorchTargets.cmake")
if("npu" IN_LIST Ctorch_FIND_COMPONENTS)
    set(Ctorch_npu_FOUND ${Ctorch_USE_NPU})
    if(Ctorch_npu_FOUND)
        if(Ctorch_FIND_REQUIRED_npu)
            find_dependency(OpenVINO 2026.0 COMPONENTS Runtime)
        else()
            find_package(OpenVINO 2026.0 QUIET COMPONENTS Runtime)
            set(Ctorch_npu_FOUND ${OpenVINO_FOUND})
        endif()
    endif()
    if(Ctorch_npu_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/CtorchNpuTargets.cmake")
    endif()
endif()
check_required_components(Ctorch)
